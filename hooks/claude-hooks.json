{
  "description": "TMCRA Memory lifecycle hooks for Claude Code. This configuration is separate from the Codex hook configuration.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/claude_run_hook.mjs", "session_start.mjs"],
            "timeout": 12,
            "statusMessage": "Loading TMCRA memory"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/claude_run_hook.mjs", "user_prompt_submit.mjs"],
            "timeout": 30,
            "statusMessage": "Recalling TMCRA memory"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/claude_run_hook.mjs", "post_tool_use.mjs"],
            "timeout": 12,
            "statusMessage": "Recording TMCRA task progress"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/claude_run_hook.mjs", "pre_compact.mjs"],
            "timeout": 12,
            "statusMessage": "Checkpointing TMCRA task memory"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/claude_run_hook.mjs", "post_compact.mjs"],
            "timeout": 12,
            "statusMessage": "Recording compaction state"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/claude_run_hook.mjs", "stop.mjs"],
            "timeout": 12,
            "statusMessage": "Saving turn to TMCRA"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/claude_run_hook.mjs", "stop.mjs"],
            "timeout": 12,
            "statusMessage": "Checkpointing failed turn to TMCRA"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/claude_run_hook.mjs", "subagent_start.mjs"],
            "timeout": 12,
            "statusMessage": "Starting isolated TMCRA subagent memory"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/claude_run_hook.mjs", "subagent_stop.mjs"],
            "timeout": 12,
            "statusMessage": "Saving subagent turn to TMCRA"
          }
        ]
      }
    ]
  }
}
